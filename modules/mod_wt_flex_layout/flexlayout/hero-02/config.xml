<?xml version="1.0" encoding="utf-8"?>
<form>
  <title>Hero 02</title>
  <categories>
    <value>Hero</value>
  </categories>
  <assets>
    <scripts>
    </scripts>
    <stylesheets>
      <path>/assets/css/style.css</path>
    </stylesheets>
  </assets>
  <fields>
    <fieldset name="global_configurations" label="" description="">
      <field type="spacer" name="fl-spacer-1" class="fl-sep" label="Module Heading" />
      <field name="mod_sub_heading" type="text" label="Sub Title" description="" filter="safehtml" />
      <field name="mod_heading" type="text" label="Section Title" description="" filter="safehtml" />
      <field name="mod_desc" type="textarea" label="Section Description" description="" cols="40" rows="6" filter="safehtml" />

      <field name="enable_container" type="list" default="0" label="Enable Container" description="">
        <option value="0">Full Width</option>
        <option value="1">Contained</option>
      </field>

      <field name="hero_content_width" type="list" default="6" label="Content Width" description="">
        <option value="3">25%</option>
        <option value="6">50%</option>
        <option value="8">75%</option>
      </field>

      <field type="spacer" name="fl-spacer-2" class="fl-sep" label="Button Configurations" />
      <field name="btn_1_title" type="text" label="Button 1 Title" description="" filter="safehtml" />
      <field name="btn_1_url" type="text" default="#" label="Button 1 Link Url" description="" />
      <field name="btn_1_type" type="list" default="btn-secondary" label="Button 1 Type" description="">
        <option value="btn-secondary">Secondary</option>
        <option value="btn-primary">Primary</option>
        <option value="btn-success">Success</option>
        <option value="btn-info">Info</option>
        <option value="btn-warning">Warning</option>
        <option value="btn-danger">Danger</option>
        <option value="btn-outline-secondary">Outline Secondary</option>
        <option value="btn-outline-primary">Outline Primary</option>
        <option value="btn-outline-success">Outline Success</option>
        <option value="btn-outline-info">Outline Info</option>
        <option value="btn-outline-warning">Outline Warning</option>
        <option value="btn-outline-danger">Outline Danger</option>
        <option value="btn-link">Link</option>
      </field>

      <field name="btn_2_title" type="text" label="Button 2 Title" description="" filter="safehtml" />
      <field name="btn_2_url" type="text" default="#" label="Button 2 Link Url" description="" />
      <field name="btn_2_type" type="list" default="btn-secondary" label="Button 2 Type" description="">
        <option value="btn-secondary">Secondary</option>
        <option value="btn-primary">Primary</option>
        <option value="btn-success">Success</option>
        <option value="btn-info">Info</option>
        <option value="btn-warning">Warning</option>
        <option value="btn-danger">Danger</option>
        <option value="btn-outline-secondary">Outline Secondary</option>
        <option value="btn-outline-primary">Outline Primary</option>
        <option value="btn-outline-success">Outline Success</option>
        <option value="btn-outline-info">Outline Info</option>
        <option value="btn-outline-warning">Outline Warning</option>
        <option value="btn-outline-danger">Outline Danger</option>
        <option value="btn-link">Link</option>
      </field>

      <field name="small_text" type="text" label="Small Text" description="" filter="safehtml" />

      <field type="spacer" name="fl-spacer-3" class="fl-sep" label="Decor Images" />
      <field name="hero_main_image" type="media" label="Main Image" description="" />
      <field name="hero_image_thumb_1" type="media" label="Image Decor 1" description="" />
      <field name="hero_image_thumb_2" type="media" label="Image Decor 2" description="" />
      <field name="hero_image_thumb_3" type="media" label="Image Decor 3" description="" />
      <field name="hero_image_thumb_4" type="media" label="Image Decor 4" description="" />
    </fieldset>

  </fields>
</form>