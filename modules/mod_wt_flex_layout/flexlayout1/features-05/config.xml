<?xml version="1.0" encoding="utf-8"?>
<form>
  <title>Features 05</title>
  <categories>
    <value>Features</value>
  </categories>
  <assets>
    <scripts>
    </scripts>
    <stylesheets>
      <path>/assets/css/style.css</path>
    </stylesheets>
  </assets>
  <fields>
    <fieldset name="global_configurations" label="" description="">
      <field type="spacer" name="fl-spacer-1" class="fl-sep" label="MOD_FLEX_LAYOUT_GLOBAL_SETTINGS" />
      <field name="feature_main_image" type="media" label="Feature Main Image" description="" />
      <field name="features_per_row" type="list" default="3" label="Item(s) per Row" description="">
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="6">6</option>
      </field>

      <field name="feature_item_gap" type="list" default="0" label="Item Gap" description="">
        <option value="0px">0</option>
        <option value="4px">4px</option>
        <option value="8px">8px</option>
        <option value="12px">12px</option>
        <option value="16px">16px</option>
        <option value="24px">24px</option>
        <option value="32px">32px</option>
        <option value="48px">48px</option>
        <option value="64px">64px</option>
      </field>

      <field name="feature_text_alignment" type="list" default="left" label="Item Text Alignment" description="">
        <option value="left">Align Left</option>
        <option value="center">Align Center</option>
        <option value="right">Align Right</option>
      </field>

      <field name="feature_btn_type" type="list" default="btn-secondary" label="Feature Button Type" description="">
        <option value="btn-secondary">Secondary</option>
        <option value="btn-primary">Primary</option>
        <option value="btn-success">Success</option>
        <option value="btn-info">Info</option>
        <option value="btn-warning">Warning</option>
        <option value="btn-danger">Danger</option>
        <option value="btn-outline-secondary">Outline Secondary</option>
        <option value="btn-outline-primary">Outline Primary</option>
        <option value="btn-outline-success">Outline Success</option>
        <option value="btn-outline-info">Outline Info</option>
        <option value="btn-outline-warning">Outline Warning</option>
        <option value="btn-outline-danger">Outline Danger</option>
        <option value="btn-link">Link</option>
      </field>
    </fieldset>

    <fieldset name="feature_configurations" label="" description="">
      <field type="spacer" name="fl-spacer-2" class="fl-sep" label="MOD_FLEX_LAYOUT_ITEM_SETTINGS" />
      <field name="feature_items" type="subform" label="Feature Item" description="" multiple="true" min="1" max="10">
        <form>
          <field name="feature_image" type="media" label="Feature Image" description="" />
          <field name="feature_icon" type="textarea" label="Icon Class / SVG" description="" cols="40" rows="6" filter="safehtml" />
          <field name="feature_title" type="text" label="Title" description="" />
          <field name="feature_desc" type="textarea" label="Description" description="" cols="40" rows="6" filter="safehtml" />
          <field name="feature_link_url" type="text" default="" label="Link Url" description="" />
        </form>
      </field>
    </fieldset>

  </fields>
</form>