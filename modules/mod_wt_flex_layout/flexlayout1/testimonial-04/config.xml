<?xml version="1.0" encoding="utf-8"?>
<form>
  <title>Testimonial 04</title>
  <categories>
    <value>Testimonial</value>
  </categories>
  <assets>
    <scripts>
      <path>assets/js/owl.carousel.min.js</path>
    </scripts>
    <stylesheets>
      <path>/assets/css/style.css</path>
      <path>assets/css/owl.carousel.min.css</path>
      <path>assets/css/owl.theme.default.min.css</path>
    </stylesheets>
  </assets>
  <fields>

    <fieldset name="global_configurations" label="" description="">
      <field type="spacer" name="fl-spacer-1" class="fl-sep" label="MOD_FLEX_LAYOUT_GLOBAL_SETTINGS" />
      <field name="show_dots_navigation" type="radio" default="false" label="Show Dots Navigation" description="" class="btn-group btn-group-yesno">
          <option value="false">Disable</option>
          <option value="true">Enable</option>
      </field>
      <field name="show_next_prev" type="radio" default="true" label="Show Next Prev" description="" class="btn-group btn-group-yesno">
          <option value="false">Disable</option>
          <option value="true">Enable</option>
      </field>
      <field name="auto_play" type="radio" default="true" label="Auto Play" description="" class="btn-group btn-group-yesno">
          <option value="false">Disable</option>
          <option value="true">Enable</option>
      </field>
    </fieldset>

    <fieldset name="testimonial_configurations" label="" description="">
      <field type="spacer" name="fl-spacer-2" class="fl-sep" label="MOD_FLEX_LAYOUT_ITEM_SETTINGS" />
      <field name="testimonial_items" type="subform" label="Customer" description="" multiple="true" min="1" max="10">
        <form>          
          <field name="customer_image" type="media" label="Image" description="" />
          <field name="customer_name" type="text" label="Name" description="" />
          <field name="customer_position" type="text" label="Position" description="" />
          <field name="customer_testimonial" type="textarea" label="Introduction" description="" cols="40" rows="6" filter="safehtml" />
          <field name="customer_website_name" type="text" label="Website Name" description="" />
          <field name="customer_website_url" type="text" label="Website Url" description="" />
          <field name="customer_rating" type="list" default="4" label="Rating" description="">
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
          </field>
        </form>
      </field>
    </fieldset>

  </fields>
</form>